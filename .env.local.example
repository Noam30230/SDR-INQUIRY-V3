# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx...
SUPABASE_SERVICE_KEY=eyJxxx...

# OpenAI
OPENAI_API_KEY=sk-...

# Collecteurs de données
PAPPERS_API_KEY=        # Pappers.fr (France) — gratuit sur pappers.fr/api
GITHUB_TOKEN=           # github.com/settings/tokens (classic, scope: public_repo)
BRAVE_SEARCH_API_KEY=   # api.search.brave.com — gratuit 2000 req/mois
NEWS_API_KEY=           # newsapi.org — gratuit 100 req/jour

# Sumble (optionnel — désactivé par défaut)
SUMBLE_API_KEY=
SUMBLE_ENABLED=false
