# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx...
SUPABASE_SERVICE_KEY=eyJxxx...

# Anthropic (scoring IA)
ANTHROPIC_API_KEY=sk-ant-...

# Collecteurs de données
PAPPERS_API_KEY=   # Pappers.fr (France) — gratuit sur pappers.fr/api
GITHUB_TOKEN=      # github.com/settings/tokens (classic, scope: public_repo)

# Stripe billing
STRIPE_SECRET_KEY=sk_live_...          # Stripe Dashboard → Developers → API Keys
STRIPE_WEBHOOK_SECRET=whsec_...        # Stripe Dashboard → Webhooks → signing secret
STRIPE_PRICE_SOLO=price_...            # Solo plan price ID (€19/month)
STRIPE_PRICE_PRO=price_...             # Pro plan price ID (€49/month)
STRIPE_PRICE_GROWTH=price_...          # Growth plan price ID (€129/month)

# App URL (used for Stripe redirect URLs)
NEXT_PUBLIC_APP_URL=https://your-domain.com
